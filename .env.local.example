# ---------------------------------------------------------------------------
# MontSong — Next.js local development configuration
#
# Copy this file to `.env.local`, then replace every placeholder before running
# the app. `.env.local` is ignored by Git; never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
DATABASE_URL="file:./data/montsong.db"

# --- Telegram storage (server-only secrets) ------------------------------
TELEGRAM_BOT_TOKEN="REPLACE_WITH_YOUR_BOT_TOKEN"
TELEGRAM_STORAGE_CHAT_ID="REPLACE_WITH_YOUR_CHAT_ID"
# TELEGRAM_API_BASE_URL="http://127.0.0.1:8081"
# TELEGRAM_API_LOCAL_MODE="false"
# TELEGRAM_DEBUG="false"

# --- Admin and authentication (server-only secrets) ----------------------
ADMIN_USERNAME="owner"
ADMIN_PASSWORD_HASH="REPLACE_WITH_SCRYPT_HASH"
AUTH_SECRET="REPLACE_WITH_48_RANDOM_BYTES_BASE64"

# --- Public site configuration (bundled into client-facing output) -------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="MontSong"

# --- Media cache and upload spool -----------------------------------------
MEDIA_CACHE_DIR="./media-cache"
MEDIA_CACHE_MAX_BYTES="2147483648"
MEDIA_CACHE_MAX_FILE_BYTES="67108864"
UPLOAD_TMP_DIR="./tmp-uploads"

# --- Upload limits --------------------------------------------------------
MAX_AUDIO_UPLOAD_BYTES="20971520"
MAX_IMAGE_UPLOAD_BYTES="5242880"

# --- Optional -------------------------------------------------------------
# ADDITIONAL_TRUSTED_ORIGINS=""
